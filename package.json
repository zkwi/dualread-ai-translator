{
  "name": "dualread-ai-translator",
  "version": "0.13.1",
  "description": "Open-source Chrome MV3 extension for AI bilingual webpage translation with OpenAI-compatible providers.",
  "license": "MIT",
  "private": true,
  "keywords": [
    "chrome-extension",
    "ai-translator",
    "bilingual-translation",
    "webpage-translation",
    "openai-compatible",
    "deepseek",
    "qwen",
    "browser-extension",
    "translation"
  ],
  "scripts": {
    "audit:public": "node scripts/audit-publication.js",
    "check": "npm run audit:public && node scripts/check-syntax.js",
    "test:shared": "node test/shared.test.js",
    "test:background": "node test/background.test.js",
    "test:study": "node test/study.test.js",
    "test:samples:config": "node test/content-samples-config.test.js",
    "test:ui": "node test/e2e-ui-fixtures.js",
    "test:local": "node test/e2e-local-fixtures.js",
    "test:layout": "node test/e2e-layout-matrix.js",
    "test:smoke": "node test/extension-smoke.js",
    "test:samples": "node test/e2e-content-samples.js",
    "test": "npm run check && npm run test:shared && npm run test:background && npm run test:study && npm run test:samples:config && npm run test:ui && npm run test:local && npm run test:layout && npm run test:smoke",
    "test:all": "npm test && npm run test:samples"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  }
}
